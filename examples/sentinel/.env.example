# Copy to a private path outside git. Never commit filled values.
# Example: /etc/alfred/sentinel.env  or  ~/alfred-private/sentinel.env

# --- Required for LLM passes ---
LITELLM_MASTER_KEY=sk-change-me
ALFRED_LITELLM_BASE=http://127.0.0.1:4000
OLLAMA_HOST=http://127.0.0.1:11434

# --- Lab-local state (no private mount names) ---
ALFRED_DATA_ROOT=./alfred-data
# DIGEST_DIR=          # default: $ALFRED_DATA_ROOT/digests/morning
# SENTINEL_LOCK=       # default: $ALFRED_DATA_ROOT/locks/vram.lock
# ALFRED_TELEMETRY_DB= # default: $ALFRED_DATA_ROOT/telemetry/telemetry.db

# Disk charts (comma-separated). Keep generic — do not publish personal mounts.
SENTINEL_DISK_MOUNTS=/

# Optional HTTP soft-checks (default: ollama/chroma/litellm/open-webui on localhost).
# SENTINEL_SERVICE_URLS=ollama=http://127.0.0.1:11434/api/tags,litellm=http://127.0.0.1:4000/health/liveliness

# Telemetry retention
ALFRED_TELEMETRY_METRICS_DAYS=90
ALFRED_TELEMETRY_RESOLVED_FINDINGS_DAYS=180
ALFRED_TELEMETRY_RUNS_DAYS=180
SENTINEL_DIGEST_RETENTION_DAYS=7

# LiteLLM model aliases (must exist in your config.yaml)
SENTINEL_REASONER_MODEL=alfred-reasoner
SENTINEL_SECURITY_MODEL=alfred-security
SENTINEL_CODER_MODEL=alfred-coder-14b

# --- Optional: ICMP network probes (your IPs only — leave empty to use gateway+DNS+public WAN) ---
# ALFRED_UNIFI_GATEWAY=
# ALFRED_UNIFI_TARGETS=
# ALFRED_WAN_TARGETS=1.1.1.1,8.8.8.8
# ALFRED_UNIFI_PING_COUNT=10

# --- Optional: controller API (off by default) ---
SENTINEL_ENABLE_CONTROLLER_API=0
# ALFRED_UNIFI_API_BASE=https://127.0.0.1:11443
# ALFRED_UNIFI_API_KEY=
# ALFRED_UNIFI_SITE=default
ALFRED_UNIFI_API_VERIFY_TLS=0

# --- Optional: Chroma memory stage (off by default) ---
SENTINEL_ENABLE_MEMORY=0
ALFRED_CHROMA_HOST=127.0.0.1
ALFRED_CHROMA_PORT=8000
ALFRED_BRONZE_COLLECTION=ephemeral_working_context
ALFRED_GOLD_COLLECTION=curated_skills_registry
ALFRED_EMBED_MODEL=nomic-embed-text
# ALFRED_DOMAINS_YAML=./routing/domains.yaml
# ALFRED_SKILLS_ROOT=./skills
# STAGED_PROMOTIONS=./alfred-data/staged_promotions

# --- Optional: mail / backups / eval (your wrappers) ---
# SENTINEL_MAIL_CMD=/usr/local/bin/my-mail-digest
# SENTINEL_BACKUP_CMD=/usr/local/bin/my-backup-nightly
SENTINEL_ENABLE_EVAL_HOOKS=0
# SENTINEL_EVAL_WEEKLY_BIN=
