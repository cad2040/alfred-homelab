# Nightly Sentinel — adjust paths to your install and private env file.
# Hold VRAM flock; prefer idle hours. Do not overlap heavy GPU jobs.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Example: 02:15 local — load private env then run
# 15 2 * * *  set -a; source /path/to/private/sentinel.env; set +a; /path/to/alfred-homelab/examples/sentinel/run-sentinel.sh >> /path/to/alfred-data/sentinel.cron.log 2>&1
